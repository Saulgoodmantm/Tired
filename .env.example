# .env.example - Fill and copy to .env on VPS (NEVER commit real .env)
APP_ENV=production
APP_URL=https://tiredofdointm.com

# Database
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=yourdbname
DB_USER=yourdbuser
DB_PASS=yourdbpass

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=tiredproduction
R2_ENDPOINT=https://<your-r2-endpoint>

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx

# Google
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_CALENDAR_ID=...

# SMTP
SMTP_HOST=smtp.example.com
SMTP_USER=contact@tiredofdointm.com
SMTP_PASS=super-secret
SMTP_PORT=587

# App secrets
ENCRYPTION_KEY=generate-a-32-byte-key
SESSION_SECRET=generate-a-long-secret